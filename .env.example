# Copy this file to ".env" and fill in your real values.
# The real .env file is git-ignored and must NEVER be committed.

# ── Broker API (example: Angel One SmartAPI) ────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_KEY=

# ── MetaTrader 5 ────────────────────────────────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Notifications (Telegram) ────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
